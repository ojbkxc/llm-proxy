# ============================================================
# codex/ 目录多模型共用配置
# ============================================================
#
# 使用方法：
#   1. 复制本文件为 .env（不需要复制即可自动生效）
#   2. 修改以下配置项
#   3. 重启脚本（多模型是重启生效，配置立即刷新）
#
# 优先级：环境变量 > .env > 硬编码默认值
#
# ============================================================

# 主网关地址
# 改这里换网关，支持 ws-proxy / cfapi 任意自定义 API
BASE_URL=http://127.0.0.1:8787/v1

# 主网关 API Key
# ws-proxy 本地不需要（复用SSO），其他请填真实 Key
API_KEY=sk-wa-f9cb7d4ba48f403797fc3f55b928ceac

# 或从环境变量读取（优先级其次）
# CF_GATEWAY_KEY=sk-your-key

# 备选网关（主网关失败时自动切换）
BASE_FALLBACK=http://127.0.0.1:8788/v1
BASE_FALLBACK_KEY=sk-your-fallback-key

# 远程配置（remote-multi.py 使用）
REMOTE_HOST=104.223.65.202
REMOTE_PORT=10122
REMOTE_USER=root
REMOTE_WORKDIR=/opt/codex
